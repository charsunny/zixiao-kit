{
  "name": "纸墨朱印",
  "rationale": "诗人志系列共用的纸墨朱印: 纸 #F2EEE4、墨 #272E2A、朱印 #963E31, 以苏轼 (东坡志) 为默认身份, accent 取朱印 —— 强调色只用于选中、方向与少量身份标识, 不铺满正文, 正文始终是墨字。数值取自系列设计规范 (POET_SERIES_DESIGN.md) 的浅深两列: surface 对应「书页」, muted 对应「次级文字」, border 与 rule 对应「细线」。规范未给 track, 取墨 6% 叠在纸上推得 (浅 #E6E3D9 / 深 #292D2A)。night 取系列深色纸面。李白的江月青、杜甫的草堂绿作为备选 accent 放在 accents 里, 由各自 App 选用; 诗人各自的完整身份 (纪年、标记形状、印文) 仍由其编成 JSON 提供, 所以这里 sealText 留空。",
  "palette": {
    "light": {
      "paper": "#F2EEE4",
      "ink": "#272E2A",
      "surface": "#FAF7F0",
      "muted": "#696B60",
      "border": "#D1D0C1",
      "track": "#E6E3D9",
      "accent": "#963E31",
      "seal": "#963E31",
      "rule": "#D1D0C1",
      "night": "#1C211F"
    },
    "dark": {
      "paper": "#1C211F",
      "ink": "#EEE9DD",
      "surface": "#242B27",
      "muted": "#B1B8A8",
      "border": "#465045",
      "track": "#292D2A",
      "accent": "#E3A08B",
      "seal": "#E3A08B",
      "rule": "#465045",
      "night": "#1C211F"
    },
    "accents": {
      "江月青": { "light": "#49697B", "dark": "#A4BED0" },
      "草堂绿": { "light": "#5B6B48", "dark": "#B3C399" }
    }
  },
  "type": {
    "display": "Source Han Serif CN Bold",
    "body": "Source Han Serif CN",
    "ui": "system"
  },
